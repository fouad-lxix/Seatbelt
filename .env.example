# Copy to .env and fill in. Never commit .env, it is gitignored.
#
# Set at least one provider key. A provider with no key is disabled.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Everything below is optional, shown values are the defaults ----

# Hard spend cap in USD. Stops new calls once reached.
MAX_SPEND_USD=5.00

# Max concurrent calls per provider.
WORKERS_PER_PROVIDER=4

# Requests per minute allowed per provider. Copy this from your account
# dashboard.
RATE_LIMIT_PER_PROVIDER=60

# How many requests can burst at once after sitting idle. Defaults to
# WORKERS_PER_PROVIDER.
RATE_LIMIT_BURST=4

# How many requests can queue before new ones are rejected.
MAX_QUEUE_DEPTH=64

# HTTP port the gateway listens on.
PORT=8080

# Fetch updated model prices daily. Set to false for air-gapped setups
# or to pin prices to this build.
PRICING_REFRESH=true
